# =============================================================================
# Slate Next-Gen Platform - Environment Template
# =============================================================================
# Copy this file to `.env` before starting local infrastructure:
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is git-ignored (see .gitignore). Never commit real credentials.
# Docker Compose automatically loads `.env` from the repository root.
#
# NOTE: Special characters in a password must be URL-encoded inside the
#       connection strings (e.g. `@` -> `%40`, `#` -> `%23`).
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL - consumed by the `postgres` service in docker-compose.yml
# -----------------------------------------------------------------------------
POSTGRES_USER=slate
POSTGRES_PASSWORD=slate_dev_password
POSTGRES_DB=slate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Database connection strings
# -----------------------------------------------------------------------------

# Primary application database (default Prisma/Drizzle connection).
DATABASE_URL="postgresql://slate:slate_dev_password@localhost:5432/slate?schema=public"

# Direct, non-pooled connection used for migrations.
DIRECT_URL="postgresql://slate:slate_dev_password@localhost:5432/slate?schema=public"

# Isolated database used by integration tests.
# Created by infrastructure/postgres/init/01-init-databases.sql on first start.
TEST_DATABASE_URL="postgresql://slate:slate_dev_password@localhost:5432/slate_test?schema=public"