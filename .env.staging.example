# =============================================================================
# Slate Next-Gen Platform - staging environment template
# Master Plan, Section 30 (Phase 1: "environment configuration", "staging").
# =============================================================================
# Copy this file to `.env.staging` on the staging host and replace every
# placeholder before the first deployment:
#
#   cp .env.staging.example .env.staging        (PowerShell: Copy-Item)
#
# `.env.staging` is git-ignored. The real values are stored as secrets and
# variables of the GitHub `staging` environment (docs/environments.md), never
# in git.
#
# Start the stack:
#   docker compose --env-file .env.staging \
#     -f docker-compose.yml -f docker-compose.staging.yml up -d
#
# Render it without starting anything (this is also the CI check):
#   docker compose --env-file .env.staging.example \
#     -f docker-compose.yml -f docker-compose.staging.yml config --quiet
#
# NOTE: Special characters in a password must be URL-encoded inside the
#       connection strings (e.g. `@` -> `%40`, `#` -> `%23`).
# =============================================================================

# -----------------------------------------------------------------------------
# Environment identity
# -----------------------------------------------------------------------------
# SLATE_ENV is the authoritative environment name: @slate/observability uses it
# (via SENTRY_ENVIRONMENT) to tag every log record and every error report.
SLATE_ENV=staging
NODE_ENV=production

# -----------------------------------------------------------------------------
# Service identity and release
# -----------------------------------------------------------------------------
SLATE_SERVICE=slate-staging
# Set by the release job to the deployed tag or commit SHA (Master Plan, Section 63).
SENTRY_RELEASE=

# -----------------------------------------------------------------------------
# PostgreSQL - consumed by the `postgres` service in docker-compose.yml
# -----------------------------------------------------------------------------
POSTGRES_USER=slate
POSTGRES_PASSWORD=replace-with-a-staging-password
POSTGRES_DB=slate
# Inside the compose network the database is reached by service name.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side binding: loopback only, in a deployment-specific port range.
POSTGRES_HOST_PORT=55432
POSTGRES_BIND_ADDRESS=127.0.0.1
# Deployment-specific stack identity (docker-compose.staging.yml).
POSTGRES_VOLUME_NAME=slate_staging_postgres_data
SLATE_NETWORK_NAME=slate_staging
POSTGRES_MEMORY_LIMIT=1g

# -----------------------------------------------------------------------------
# Database connection strings
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://slate:replace-with-a-staging-password@postgres:5432/slate?schema=public"
DIRECT_URL="postgresql://slate:replace-with-a-staging-password@postgres:5432/slate?schema=public"

# Staging is not a test environment: integration suites run against an isolated
# database on a developer machine or in CI, never against staging data.
# TEST_DATABASE_URL is intentionally not set here.

# -----------------------------------------------------------------------------
# Public endpoints (become real once the first app is deployable in Phase 4)
# -----------------------------------------------------------------------------
SLATE_APP_URL=https://app.staging.example.invalid
SLATE_CONTROL_PLANE_URL=https://control.staging.example.invalid
SLATE_PUBLIC_URL=https://staging.example.invalid

# -----------------------------------------------------------------------------
# Observability baseline (docs/observability.md)
# -----------------------------------------------------------------------------
# Production-like environments log at info; debug belongs on a developer machine.
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_ENVIRONMENT=staging
# Empty means error monitoring is disabled: fill in the staging project DSN.
SENTRY_DSN=
# Set to `true` only for a deliberate, temporary monitoring outage.
SLATE_DISABLE_ERROR_MONITORING=false