{
  "name": "@slate/database",
  "version": "0.1.0",
  "private": true,
  "description": "Strict-TypeScript database abstraction for the Slate Next-Gen Platform monorepo: Kysely on pg, tenant-scoped queries and audited logging. See docs/adr/001-database-query-toolkit.md.",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./env": "./src/env.ts",
    "./tenant": "./src/tenant.ts",
    "./types": "./src/types.ts",
    "./migrations": "./src/migrations/index.ts"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@slate/observability": "*",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@slate/config": "*",
    "@slate/testing": "*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.6.11",
    "@vitest/coverage-v8": "^5.0.1",
    "vitest": "^5.0.1"
  }
}
