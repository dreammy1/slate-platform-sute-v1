{
  "openapi": "3.1.0",
  "info": {
    "title": "Slate Core API",
    "version": "0.1.0",
    "description": "SLATE-203 scaffold contract. The tenant is always resolved server-side from the session principal, never from a client header alone (Master Plan Section 13). This is a stub committed so later phases can contract-test. The paths below are relative to the versioned mount: browsers reach them at /api/v1 (Section 58, ADR 008 §5) — the prefix is owned by @slate/api-client (API_PREFIX)."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "The versioned external mount (Section 58). Frontend apps mount createHttpHandler behind /api/v1/[...path] and the browser client prefixes every request with API_PREFIX."
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "slate_session",
        "description": "Server-verified session. The scaffold adapter takes the principal from trusted session middleware."
      }
    },
    "parameters": {
      "TenantId": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": false,
        "description": "Tenant the request acts on. Honored only when the session authorizes it; 403 otherwise. A session-bound active tenant wins and the header may only repeat it.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "email", "name"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "name"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "Setting": {
        "type": "object",
        "required": ["key", "value", "valueType"],
        "description": "A tenant setting. `valueType` records the type the value was written with so `value` round-trips unchanged.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Dotted, namespaced key (for example `branding.locale`).",
            "example": "branding.locale"
          },
          "value": {
            "description": "The stored value; its JSON type always agrees with `valueType`.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          },
          "valueType": {
            "type": "string",
            "enum": ["string", "number", "boolean", "json"]
          }
        },
        "example": {
          "key": "branding.locale",
          "value": "en-GB",
          "valueType": "string"
        }
      },
      "UpdateSettingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value"],
        "description": "Only `value` is accepted: the tenant comes from the resolved session context and `valueType` is derived from the value, so no client may supply either.",
        "properties": {
          "value": {
            "description": "The value to store. `undefined` is not expressible in JSON, so omit the field is rejected rather than stored.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              },
              {
                "type": "array"
              }
            ]
          }
        },
        "example": {
          "value": "en-GB"
        }
      },
      "FeatureFlagMap": {
        "type": "object",
        "description": "Server-authoritative flag map for the resolved tenant: `override -> registry default -> false`. Only flags declared in the code-owned registry appear, and an undeclared key always resolves to `false` rather than erroring.",
        "additionalProperties": {
          "type": "boolean"
        },
        "example": {
          "feature.new-checkout": true,
          "feature.restaurant.v1": false
        }
      },
      "UpdateFeatureFlagRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled"],
        "description": "A boolean sets the tenant override and `null` clears it, so the tenant reverts to the registry default. A client never supplies a tenant id.",
        "properties": {
          "enabled": {
            "type": ["boolean", "null"]
          }
        },
        "example": {
          "enabled": true
        }
      },
      "FeatureFlag": {
        "type": "object",
        "required": ["key", "enabled"],
        "description": "The resolved state of one flag after the write, not the raw stored override.",
        "properties": {
          "key": {
            "type": "string",
            "example": "feature.new-checkout"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "JobSummary": {
        "type": "object",
        "description": "Lifecycle metadata only. The payload, idempotency key and lease token are never returned (ADR 004).",
        "required": [
          "id",
          "type",
          "status",
          "attempts",
          "maxAttempts",
          "availableAt",
          "createdAt",
          "updatedAt",
          "finishedAt",
          "lastErrorCode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "succeeded", "failed"]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "availableAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "lastErrorCode": {
            "type": ["string", "null"],
            "enum": [
              "handler_error",
              "payload_invalid",
              "unknown_type",
              "handler_timeout",
              "lease_lost",
              null
            ]
          }
        }
      }
    },
    "responses": {
      "UnauthorizedTenantContext": {
        "description": "401 when no tenant can be resolved or the session is absent; 403 when the requested tenant is not authorized (no query is issued).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Unauthorized tenant context"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated actor lacks the required permission for the tenant.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Request rejected"
            }
          }
        }
      },
      "Conflict": {
        "description": "A unique constraint was violated (for example a duplicate email).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Request rejected"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The request is not usable: a malformed body or unknown field, an invalid or over-long key, a value that cannot be stored, or an undeclared feature flag key. Rejected before any query or write.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Request rejected"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected failure; the request transaction is rolled back so no partial write survives.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Internal server error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List the members of the resolved tenant",
        "description": "Requires the `users.read` permission in the resolved tenant. Rows are read through the tenant-scoped helper, so another tenant's members are not returned.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Members of the resolved tenant (at most 100).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["users"],
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Provision an inactive user in the resolved tenant",
        "description": "Requires the `users.write` permission. The user, the tenant membership and exactly one attributed `audit_log` row commit in a single transaction before 201 is returned; `app.user.created` and `app.audit.recorded` are then published on the in-process bus.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The user was created and audited.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["user"],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body is not an object, carries unknown fields, or fails validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Request rejected"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "415": {
            "description": "The Content-Type is not application/json (HTTP adapter).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Expected application/json"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/settings": {
      "get": {
        "operationId": "listSettings",
        "summary": "List the settings of the resolved tenant",
        "description": "Requires the `settings.read` permission in the resolved tenant. Rows are read through the tenant-scoped helper, so another tenant's settings are never returned. Nothing is cached: a committed change is visible on the next call.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Every setting of the resolved tenant, ordered by key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["settings"],
                  "properties": {
                    "settings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Setting"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/settings/{key}": {
      "put": {
        "operationId": "putSetting",
        "summary": "Upsert one setting in the resolved tenant",
        "description": "Requires the `settings.write` permission. The value's type is derived from the value itself, so it round-trips unchanged. The setting and exactly one attributed `audit_log` row commit in a single transaction before 200 is returned; `settings.updated` is then published on the in-process bus carrying the key only, never the value (Master Plan Section 61).",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "Dotted, namespaced setting key. URL-decoded, then validated: a malformed or over-long key is a 400 and no query is issued.",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "example": "branding.locale"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The setting was written and audited.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["setting"],
                  "properties": {
                    "setting": {
                      "$ref": "#/components/schemas/Setting"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "415": {
            "description": "The Content-Type is not application/json (HTTP adapter).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Expected application/json"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/features": {
      "get": {
        "operationId": "listFeatures",
        "summary": "Resolve the feature flags of the resolved tenant",
        "description": "Requires the `features.read` permission. The map is computed server-side on every call as `tenant override -> registry default -> false`; a key nobody declared resolves to `false` and never errors (Master Plan Section 60). Flag definitions are code-owned, so adding one needs no migration.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "The resolved flag map for the resolved tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["features"],
                  "properties": {
                    "features": {
                      "$ref": "#/components/schemas/FeatureFlagMap"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/features/{key}": {
      "put": {
        "operationId": "putFeatureFlag",
        "summary": "Set or clear a feature flag override for the resolved tenant",
        "description": "Requires the `features.write` permission. `true`/`false` writes the tenant override and `null` clears it so the tenant reverts to the registry default. An undeclared key is a 400, so a client can never switch on behaviour nobody declared. The override and exactly one attributed `audit_log` row commit in a single transaction before 200 is returned; `feature.flag.updated` is then published carrying the key only, never the resolved state.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "A key declared in the code-owned flag registry. URL-decoded; an undeclared key is a 400 and no query is issued.",
            "schema": {
              "type": "string"
            },
            "example": "feature.ai.assistant"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFeatureFlagRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The override was applied (or cleared) and audited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureFlag"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "415": {
            "description": "The Content-Type is not application/json (HTTP adapter).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Expected application/json"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List the resolved tenant's background jobs",
        "description": "Requires the `jobs.read` permission. Read-only: jobs are created inside domain transactions (`enqueue`), never through the API. Returns lifecycle metadata only — payload, idempotency key and lease token are never returned (ADR 004).",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["pending", "running", "succeeded", "failed"]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation token from `nextCursor`. Binds the page window only; it never influences tenant scope.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the tenant's jobs, ascending by (createdAt, id).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["jobs", "nextCursor"],
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/JobSummary"
                      }
                    },
                    "nextCursor": {
                      "type": ["string", "null"]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A limit, status or cursor parameter failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Request rejected"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getJob",
        "summary": "Fetch one background job of the resolved tenant",
        "description": "Requires the `jobs.read` permission. A foreign tenant's job id and a missing id are the same 404.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job's lifecycle metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["job"],
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/JobSummary"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "No such job in the resolved tenant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Request rejected"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "healthLive",
        "summary": "Liveness probe",
        "description": "Unauthenticated by design (ADR 007): an orchestrator has no session, and liveness must not depend on any dependency, so a broken database cannot get a healthy process killed. The body discloses no configuration or version detail.",
        "responses": {
          "200": {
            "description": "The process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["live"]
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Only GET is served.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Request rejected"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "summary": "Readiness probe",
        "description": "Unauthenticated by design (ADR 007). 200 only when every checked dependency (currently the database) answers; 503 otherwise. A failing dependency is reported in the logs, never in the response body.",
        "responses": {
          "200": {
            "description": "Every dependency is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ready"]
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Only GET is served.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Request rejected"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["unavailable"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search/{entity}": {
      "get": {
        "operationId": "querySearch",
        "summary": "Query the resolved tenant's search index",
        "description": "Requires the `search.read` permission. PostgreSQL full-text search (ADR 007): the match and the tenant predicate are the same query, so another tenant's documents are not expressible, and the query string is always a bound parameter. Ranking is `ts_rank` with ties broken on `recordId`, so identical data answers in the same order. Every query writes exactly one `search.query` audit row in the same transaction.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "entity",
            "in": "path",
            "required": true,
            "description": "Dotted, namespaced entity (for example `docs.page`). An invalid entity is a 400 and no query is issued.",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked hits; a hit never carries the stored body.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["entity", "query", "count", "hits"],
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "hits": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["entity", "recordId", "title", "rank"],
                        "properties": {
                          "entity": {
                            "type": "string"
                          },
                          "recordId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "title": {
                            "type": "string"
                          },
                          "rank": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "operationId": "indexSearch",
        "summary": "Index (upsert) one document for the resolved tenant",
        "description": "Requires the `search.write` permission. `recordId` identifies the row the text describes and is re-validated as a UUID, so it can never smuggle a path or a SQL fragment; re-indexing the same (entity, recordId) replaces its text. The document and exactly one `search.indexed` audit row commit in a single transaction; `search.indexed` is published afterwards carrying the entity only, never the text.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "entity",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recordId", "title", "body"],
                "properties": {
                  "recordId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 20000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The document is indexed and audited.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["entity", "recordId"],
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "recordId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedTenantContext"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "415": {
            "description": "The Content-Type is not application/json (HTTP adapter).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Expected application/json"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  }
}
