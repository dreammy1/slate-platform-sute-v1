{
  "name": "@slate/settings",
  "version": "0.1.0",
  "private": true,
  "description": "Tenant-scoped system settings and server-authoritative feature flags for the Slate Next-Gen Platform (SLATE-204). See docs/adr/003-system-settings-and-feature-flags.md.",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./keys": "./src/keys.ts",
    "./values": "./src/values.ts",
    "./flags": "./src/flags.ts",
    "./flags-service": "./src/flags-service.ts",
    "./query-service": "./src/query-service.ts",
    "./settings": "./src/settings.ts",
    "./database": "./src/database.ts"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@slate/database": "*",
    "kysely": "^0.29.6"
  },
  "devDependencies": {
    "@slate/config": "*",
    "@slate/testing": "*",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "vitest": "^5.0.1"
  }
}
