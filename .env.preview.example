# =============================================================================
# Slate Next-Gen Platform - preview environment template
# Master Plan, Section 30 (Phase 1: "preview builds") and Section 55
# ("preview deployments").
# =============================================================================
# A preview is a short-lived, isolated copy of the platform that belongs to one
# pull request. It uses the same overlay as staging, with per-preview stack
# identity, so a preview can never touch staging data or another preview.
#
# Per pull request, copy this file to `.env.preview` and replace `<pr>` with the
# pull request number:
#
#   cp .env.preview.example .env.preview
#
# Then:
#   docker compose --env-file .env.preview \
#     -f docker-compose.yml -f docker-compose.staging.yml up -d
#
# Tear down (removes the preview volume and therefore its database):
#   docker compose --env-file .env.preview \
#     -f docker-compose.yml -f docker-compose.staging.yml down -v
#
# `.env.preview` is git-ignored; CI provides the values from the GitHub
# `preview` environment (docs/environments.md).
# =============================================================================

# -----------------------------------------------------------------------------
# Environment identity
# -----------------------------------------------------------------------------
SLATE_ENV=preview
NODE_ENV=production
SLATE_SERVICE=slate-preview
SENTRY_RELEASE=

# -----------------------------------------------------------------------------
# Preview identity - every `<pr>` placeholder must be replaced
# -----------------------------------------------------------------------------
PREVIEW_ID=pr-<pr>
PREVIEW_URL=https://pr-<pr>.preview.example.invalid

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=slate
POSTGRES_PASSWORD=replace-with-a-preview-password
POSTGRES_DB=slate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Every preview binds its own host port; pick one outside the staging range.
POSTGRES_HOST_PORT=55<pr>
POSTGRES_BIND_ADDRESS=127.0.0.1
# Per-preview stack identity: the volume and the network must never be shared.
POSTGRES_VOLUME_NAME=slate_preview_pr<pr>_postgres_data
SLATE_NETWORK_NAME=slate_preview_pr<pr>
POSTGRES_MEMORY_LIMIT=512m

# -----------------------------------------------------------------------------
# Database connection strings
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://slate:replace-with-a-preview-password@postgres:5432/slate?schema=public"
DIRECT_URL="postgresql://slate:replace-with-a-preview-password@postgres:5432/slate?schema=public"

# No TEST_DATABASE_URL: previews are not integration test targets.

# -----------------------------------------------------------------------------
# Public endpoints
# -----------------------------------------------------------------------------
SLATE_APP_URL=https://pr-<pr>.preview.example.invalid
SLATE_CONTROL_PLANE_URL=https://pr-<pr>-control.preview.example.invalid
SLATE_PUBLIC_URL=https://pr-<pr>-public.preview.example.invalid

# -----------------------------------------------------------------------------
# Observability baseline (docs/observability.md)
# -----------------------------------------------------------------------------
# A preview is a debugging environment: verbose logs, separate DSN/environment,
# and a short retention window (preview environments are torn down with the PR).
LOG_LEVEL=debug
LOG_FORMAT=json
SENTRY_ENVIRONMENT=preview
SENTRY_DSN=
SLATE_DISABLE_ERROR_MONITORING=false